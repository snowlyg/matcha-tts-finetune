+    # The mel buffers saved in a warm-started checkpoint may differ from the cmvn used
+    # to normalize training features (train.py normalizes with --cmvn), which silently
+    # affine-warps the exported mel. --cmvn is the source of truth here; for a
+    # from-scratch run the two pairs are identical, so this is a no-op.
+    ckpt_mean, ckpt_std = float(model.mel_mean), float(model.mel_std)
+    if (ckpt_mean, ckpt_std) != (stats["fbank_mean"], stats["fbank_std"]):
+        logging.warning(
+            "Checkpoint mel buffers (%.4f, %.4f) differ from --cmvn (%.4f, %.4f); "
+            "overriding with --cmvn so denormalization matches training normalization."
+            % (ckpt_mean, ckpt_std, stats["fbank_mean"], stats["fbank_std"])
+        )
+        model.mel_mean.fill_(stats["fbank_mean"])
+        model.mel_std.fill_(stats["fbank_std"])
+
